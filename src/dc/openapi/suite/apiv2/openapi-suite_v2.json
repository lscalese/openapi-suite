{
  "openapi": "3.0.0",
  "info": {
    "title": "OpenAPI Suite API",
    "description": "API for OpenAPI Suite services",
    "version": "2.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:52796/openapisuite",
      "description": "API Version 2"
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/ping": {
      "get": {
        "summary": "Check if the service is running",
        "description": "Simple endpoint to verify the API is responsive",
        "operationId": "ping",
        "responses": {
          "200": {
            "description": "Service is running",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PingResponse"
                }
              }
            }
          }
        }
      }
    },
    "/validate-document-collection": {
      "post": {
        "summary": "Validate a collection of documents",
        "description": "Allows uploading multiple files with associated keys for linking to modelPackages",
        "operationId": "validateDocumentCollection",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/DocumentCollectionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validation results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SimpleErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SimpleErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/generate-ast-collection": {
      "post": {
        "summary": "Generate AST from document collection",
        "description": "Converts a collection of documents into an Abstract Syntax Tree (AST) representation",
        "operationId": "generateASTCollection",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/DocumentCollectionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "AST successfully generated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ASTCollection"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SimpleErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SimpleErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PingResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          },
          "message": {
            "type": "string",
            "example": "Service is running"
          }
        }
      },
      "ValidationResult": {
        "type": "object",
        "properties": {
          "isValid": {
            "type": "boolean"
          },
          "errors": {
            "type": "array",
            "items": {
                "type": "string"
            }
          },
          "expectedExternalDocuments": {
            "type": "array",
            "nullable": true,
            "items": {
              "type": "string"
            }
          },
          "missingExternalDocuments": {
            "type": "array",
            "nullable": true,
            "items": {
              "type": "string"
            }
          },
          "undefinedReferences": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "GenerateModelSettings": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "description": "Key that links to the uploaded document"
          },
          "modelPackage": {
            "type": "string",
            "description": "Model package name associated with the document"
          }
        }
      },
      "GenerateModelsRequest": {
        "type": "object",
        "properties": {
          "ASTCollection": {
            "$ref": "#/components/schemas/ASTCollection"
          }
        }
      },
      "DocumentCollectionRequest": {
        "required": [
          "documents"
        ],
        "type": "object",
        "properties": {
          "documents": {
            "type": "array",
            "description": "Text files to upload for validation",
            "items": {
              "type": "string",
              "format": "binary"
            }
          },
          "documentKeys": {
            "type": "array",
            "description": "Keys to identify each uploaded document for linking with modelPackages",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "SimpleErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Error message",
            "example": "An error occurred while processing your request"
          }
        }
      },
      "ASTInfo": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "API title"
          },
          "version": {
            "type": "string",
            "description": "API version"
          },
          "description": {
            "type": "string",
            "description": "API description"
          }
        }
      },
      "ASTServer": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "Server URL"
          },
          "description": {
            "type": "string",
            "description": "Server description"
          }
        }
      },
      "ASTParameter": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Parameter name"
          },
          "in": {
            "type": "string",
            "description": "Parameter location"
          },
          "description": {
            "type": "string",
            "description": "Parameter description"
          },
          "required": {
            "type": "boolean",
            "description": "Whether parameter is required"
          },
          "schema": {
            "type": "object",
            "description": "Parameter schema"
          }
        }
      },
      "ASTModelProperty": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Property name"
          },
          "type": {
            "type": "string",
            "description": "Property type"
          },
          "description": {
            "type": "string",
            "description": "Property description"
          },
          "required": {
            "type": "boolean",
            "description": "Whether the property is required"
          },
          "format": {
            "type": "string",
            "description": "Property format"
          },
          "example": {
            "type": "string",
            "description": "Example value"
          },
          "nullable": {
            "type": "boolean",
            "description": "Whether the property can be null"
          }
        }
      },
      "ASTModel": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Model name"
          },
          "description": {
            "type": "string",
            "description": "Model description"
          },
          "properties": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ASTModelProperty"
            },
            "description": "Model properties"
          }
        }
      },
      "ASTCollection": {
        "type": "object",
        "properties": {
          "ASTs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ASTResponse"
            }
          }
        }
      },
      "ASTResponse": {
        "type": "object",
        "description": "Abstract Syntax Tree (AST) representation of the OpenAPI Specification based on dc.openapi.common.ast.OAS",
        "properties": {
          "openAPI": {
            "type": "string",
            "description": "OpenAPI version"
          },
          "info": {
            "$ref": "#/components/schemas/ASTInfo"
          },
          "servers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ASTServer"
            }
          },
          "paths": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ASTPath"
            }
          },
          "responses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ASTResponseItem"
            }
          },
          "commonParameters": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ASTParameter"
            }
          },
          "models": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ASTModel"
            }
          },
          "externalReference": {
            "type": "string",
            "description": "External reference used by other OpenAPI Specifications"
          }
        }
      },
      "ASTResponseItem": {
        "type": "object",
        "description": "Represents a response item in the OpenAPI specification (dc.openapi.common.ast.Response)",
        "properties": {
          "statusCode": {
            "type": "string",
            "description": "HTTP status code"
          },
          "description": {
            "type": "string",
            "description": "Response description"
          },
          "contentType": {
            "type": "string",
            "description": "Content type of the response"
          },
          "example": {
            "type": "string",
            "description": "Example of the response"
          },
          "modelProperty": {
            "$ref": "#/components/schemas/ASTModelProperty",
            "description": "Model property associated with the response"
          },
          "headers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ASTModelProperty"
            },
            "description": "Response headers"
          }
        }
      },
      "ASTOperation": {
        "type": "object",
        "properties": {
          "operationId": {
            "type": "string",
            "description": "Unique identifier for the operation"
          },
          "method": {
            "type": "string",
            "description": "HTTP method (GET, POST, etc.)"
          },
          "summary": {
            "type": "string",
            "description": "Short summary of the operation"
          },
          "description": {
            "type": "string",
            "description": "Detailed description of the operation"
          },
          "parameters": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ASTParameter"
            },
            "description": "Operation parameters"
          },
          "responses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ASTResponseItem"
            },
            "description": "Operation responses"
          },
          "requestBody": {
            "$ref": "#/components/schemas/ASTRequestBody",
            "description": "Request body for the operation"
          }
        }
      },
      "ASTRequestBody": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "description": "Description of the request body"
          },
          "contentType": {
            "type": "string",
            "description": "Content type of the request body"
          },
          "required": {
            "type": "boolean",
            "description": "Whether the request body is required"
          },
          "modelProperty": {
            "$ref": "#/components/schemas/ASTModelProperty",
            "description": "Model property associated with the request body"
          }
        }
      },
      "ASTPath": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Path string"
          },
          "operations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ASTOperation"
            },
            "description": "Path operations"
          },
          "parameters": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ASTParameter"
            },
            "description": "Path parameters"
          }
        }
      }
    },
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "description": "HTTP Basic Authentication",
        "scheme": "basic"
      }
    }
  }
}